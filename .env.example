# QBIT runtime environment for Docker Compose & Production
# Copy to .env at repo root and edit. NEVER commit the real .env with secrets.

# --- Core Application & Environment ---
QBIT_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QBIT_SECRET_KEY=change-me-long-random-secret-key-at-least-48-chars

# --- Postgres Database (qbit-db service) ---
POSTGRES_DB=qbit
POSTGRES_USER=qbit
POSTGRES_PASSWORD=change-me-strong-postgres-password

# --- Redis (qbit-redis service) ---
REDIS_PASSWORD=change-me-strong-redis-password

# --- Storage & Networking ---
QBIT_DATA_HOST_PATH=./qbit-data
QBIT_API_PORT=8000
QBIT_API_BIND_HOST=127.0.0.1
QBIT_CORS_ORIGINS=https://app.yourdomain.com
QBIT_LOG_LEVEL=INFO

# --- Security & Auth Hardening ---
QBIT_COOKIE_SECURE=true
QBIT_LOGIN_MAX_FAILED_ATTEMPTS=10
QBIT_LOGIN_LOCKOUT_MINUTES=15
QBIT_RATE_LIMIT_LOGIN_PER_MIN=10
QBIT_SESSION_TTL_MINUTES=480

# --- Worker Runtime & Backups ---
QBIT_WORKER_DRAIN_SECONDS=30
QBIT_WORKER_LEASE_SECONDS=120
QBIT_WORKER_MAX_CONCURRENT_JOBS=2
QBIT_DISK_WARN_PERCENT=85
QBIT_BACKUP_SCHEDULE_HOURS=24
QBIT_BACKUP_RETENTION_DAILY=14
QBIT_BACKUP_RETENTION_WEEKLY=8
QBIT_BACKUP_RETENTION_MONTHLY=6

# --- Webhook Shared Secrets ---
EMAIL_WEBHOOK_SECRET=change-me-webhook-secret-min-32-chars
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# --- Scraping Engine (Phase 3 & 4) ---
QBIT_SCRAPER_DISABLED_ACTORS=
QBIT_SCRAPER_JOB_TIMEOUT_SECONDS=3600
QBIT_SCRAPER_REQUEST_TIMEOUT_SECONDS=20
QBIT_SCRAPER_MAX_RESPONSE_MB=5
QBIT_SCRAPER_RPS_PER_HOST=1.0
QBIT_SCRAPER_CONCURRENCY=4
QBIT_SCRAPER_MAX_RETRIES=3
QBIT_SCRAPER_BATCH_SIZE=100
QBIT_SCRAPER_ALLOW_PRIVATE_TARGETS=false
QBIT_SCRAPER_ALLOWED_PORTS=80,443
QBIT_MAPS_PROVIDER=none
# QBIT_MAPS_PROVIDER_URL=https://your-provider.example.com/v1/search
# QBIT_MAPS_PROVIDER_API_KEY=

# --- Directory & Commercial B2B Portals (Phase 4) ---
# Direct scraping of IndiaMART and Justdial is prohibited under their respective terms.
# Lawful access requires authorized partner API credentials.
# QBIT_INDIAMART_API_KEY=
# QBIT_JUSTDIAL_API_KEY=

# --- Marketing & Provider Settings (Phase 5, 6, 7) ---
QBIT_MARKETING_ALLOW_MOCK_PROVIDER=false
QBIT_MARKETING_RATE_PER_MINUTE=10
QBIT_MARKETING_RATE_PER_HOUR=100

# WhatsApp Cloud API
WHATSAPP_PROVIDER=whatsapp_cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_PHONE_NUMBER_ID=

# Email Provider (SMTP or API)
EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@yourdomain.com
# SMTP_PASSWORD=
SMTP_SECURITY=STARTTLS
# QBIT_EMAIL_UNSUBSCRIBE_BASE_URL=https://app.yourdomain.com
QBIT_EMAIL_DEFAULT_TRACK_OPENS=false
QBIT_EMAIL_DEFAULT_TRACK_CLICKS=false
QBIT_EMAIL_APPEND_UNSUBSCRIBE_FOOTER=true

# --- Workflow Automation Engine (Phase 9) ---
QBIT_AUTOMATION_MAX_NODES=50
QBIT_AUTOMATION_MAX_STEPS_PER_EXECUTION=100
QBIT_AUTOMATION_MAX_RETRIES=3
QBIT_AUTOMATION_RETRY_BASE_SECONDS=30
QBIT_AUTOMATION_RETRY_MAX_SECONDS=3600
QBIT_AUTOMATION_MAX_EXECUTIONS_PER_WINDOW=10
QBIT_AUTOMATION_WINDOW_MINUTES=60
QBIT_AUTOMATION_MAX_CAUSATION_DEPTH=2
QBIT_AUTOMATION_LEASE_SECONDS=300
QBIT_AUTOMATION_BATCH_SIZE=10
QBIT_AUTOMATION_MAX_WAIT_HOURS=720
QBIT_AUTOMATION_ENABLE_TEAM_ASSIGN=false
QBIT_AUTOMATION_ENABLE_START_CAMPAIGN=true

# --- Analytics & Reporting Engine (Phase 10) ---
QBIT_ANALYTICS_CACHE_TTL_SECONDS=60
QBIT_ANALYTICS_AGGREGATION_INTERVAL_SECONDS=3600
QBIT_ANALYTICS_AGGREGATION_ENABLED=true
QBIT_ANALYTICS_MAX_SNAPSHOT_ROWS=10000

# --- AI Agents, Lead Intelligence & Sales Copilot (Phase 9) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini
AI_REASONING_MODEL=gpt-4o
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT=60
AI_MAX_COST_PER_RUN=0.50
QBIT_AI_ALLOW_MOCK_PROVIDER=false
